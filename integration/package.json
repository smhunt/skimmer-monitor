{
  "name": "skimmer-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MQTT→Postgres ingestion bridge and MCP server for the skimmer water level monitor",
  "scripts": {
    "build": "tsc",
    "ingest": "tsx src/ingest.ts",
    "mcp": "tsx src/mcp-server.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "db:init": "psql \"$DATABASE_URL\" -f schema.sql"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
